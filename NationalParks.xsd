<?xml version="1.0" encoding="utf-8"?>
<schema
    elementFormDefault="qualified"
    xmlns="http://www.w3.org/2001/XMLSchema"
>
	<element name="NationalParks">
		<complexType>
			<sequence>
				<element name="NationalPark" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="Name" type="string"></element>
							<element name="Phone" type="string" maxOccurs="unbounded"></element>
							<element name="Address">
								<complexType>
									<sequence>
										<element name="Number" type="string"></element>
										<element name="Street" type="string"></element>
										<element name="City" type="string"></element>
										<element name="State" type="string"></element>
										<element name="Zip" type="string"></element>
									</sequence>
									<attribute name="NearestAirport" type="string" use="required"></attribute>
								</complexType>
							</element>
						</sequence>
						<attribute name="Rating" type="float" use="optional"></attribute>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
